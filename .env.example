# Copia este archivo a ".env" y cambia los valores. NUNCA subas el ".env" a GitHub.

# --- PostgreSQL (los usa docker-compose y la app) ---
POSTGRES_USER=kiri
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=kiri_db
DATABASE_URL=postgresql://kiri:cambia_esta_password@localhost:5435/kiri_db

# --- JWT (genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))") ---
SECRET_KEY=pega_aqui_una_clave_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- MinIO (los usa docker-compose y la app) ---
MINIO_ROOT_USER=kiri_admin
MINIO_ROOT_PASSWORD=cambia_esta_password_minio
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=kiri
MINIO_SECURE=false
